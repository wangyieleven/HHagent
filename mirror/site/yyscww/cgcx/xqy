            .flip-card {
                position: relative;
                width: 100%;
                height: 100%;
                transition: transform 0.6s;
                transform-style: preserve-3d;
            }

            .flip-card.flipped {
                transform: rotateY(180deg);
            }

            .flip-card-front,
            .flip-card-back {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                min-height: 240px;
                backface-visibility: hidden;
                -webkit-backface-visibility: hidden;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                padding: 20px;
                box-sizing: border-box;
                overflow-y: auto;
            }

